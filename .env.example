PORT=8787
NARA_PORT=8787
NARA_PROFILE=default
PROVIDERS_FILE=config/providers.local.yaml

# Optional bearer credential for physical devices connecting to /device.
# Prefer provisioning the matching token into device NVS/runtime settings.
NARA_DEVICE_TOKEN=

# Runtime-private device lifecycle/claim registry. Secrets are stored hashed.
NARA_DEVICE_REGISTRY_FILE=data/device-registry.json

# Optional phone/browser audio bridge. Use a long random bearer secret and
# serve the gateway through HTTPS before using microphones from a real phone.
# The browser passes this secret as a WebSocket subprotocol, never in the URL.
# NARA_PHONE_BRIDGE_TOKEN=replace-with-at-least-32-random-characters

# Optional strong human viewer credential layer for phone sessions.
# Requires NARA_PEOPLE_FILE. Admin issuance/revocation uses the admin token;
# stored human credentials are hashed and exchanged for short-lived session
# tokens before the WebSocket opens. This is an interim strong bearer flow;
# passkeys/WebAuthn can later replace credential issuance without changing
# the viewer/session boundary.
# NARA_HUMAN_AUTH_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# NARA_HUMAN_CREDENTIAL_REGISTRY_FILE=data/human-credentials.json

# Optional passkey/WebAuthn login for strong human viewer authentication.
# RP ID is a bare hostname (no scheme/port/path). Origins are exact browser
# origins and must use HTTPS except localhost development. Passkey enrollment
# starts from a one-time admin-issued token; successful login mints the same
# short-lived viewer session used by the phone bridge and temporary physical
# device viewer grants.
# NARA_PASSKEY_RP_ID=nara.example.com
# NARA_PASSKEY_RP_NAME=Nara
# NARA_PASSKEY_ORIGINS=https://nara.example.com
# NARA_PASSKEY_FILE=data/passkeys.json
# In NODE_ENV=production, passkey RP/origins must not be localhost and all
# browser origins must be HTTPS. Authenticated viewer sessions can add backup
# passkeys for themselves and revoke their own passkeys except the last active
# one. Register at least two authenticators before relying on self-service
# recovery.

# Optional runtime-private person directory and speaker-identification service.
# Speaker identity runs beside voice, not inside the LLM/live-voice prompt.
# Thresholds MUST be calibrated with real device microphones before production.
# NARA_PEOPLE_FILE=data/people.json
# NARA_SPEAKER_ID_URL=http://127.0.0.1:8790/identify
# NARA_SPEAKER_SERVICE_TOKEN=
# NARA_SPEAKER_MIN_CONFIDENCE=0.80
# NARA_SPEAKER_MIN_MARGIN=0.08
# NARA_SPEAKER_MIN_AUDIO_MS=700

# Optional personal-memory source for realtime voice.
# Physical firmware voice remains guest/public-scoped without a strong viewer.
# Authenticated phone sessions may bind a verified person and use the same
# existing viewer-aware memory policy for trusted/private facts.
NARA_PERSONAL_MEMORY_FILE=data/personal-memory.json
# NARA_MEMORY_SUBJECT_ID=person:owner
#
# Optional outside production, REQUIRED when personal memory is enabled under
# NODE_ENV=production. Values are 32-byte random keys encoded as base64url.
# Keep keys in a secret manager, not Git. During rotation, retain the old key
# in the JSON map for reads and set the new ID active; the memory file is
# re-encrypted with the active key when opened.
# NARA_PRIVATE_DATA_ACTIVE_KEY_ID=memory-2026-09
# NARA_PRIVATE_DATA_KEYS_JSON={"memory-2026-09":"<32-byte-base64url-key>"}

# Optional privacy-filtered offline capsule export.
# This exports only facts the configured recipient is already allowed to see.
# The HTTP bearer authorizes export administration; it does not change memory
# visibility. Put offline_capsule.json into a private device asset pack.
# NARA_OFFLINE_CAPSULE_ADMIN_TOKEN=replace-with-at-least-24-random-characters
# NARA_OFFLINE_CAPSULE_RECIPIENT_ID=person:recipient
# NARA_OFFLINE_CAPSULE_SUBJECT_ID=person:creator

# Optional remote personal-content contributor edge.
# Put this behind HTTPS/reverse-proxy TLS in production. The contributor token
# is deliberately scoped to one subject and an allowlist of viewers; it is not
# a device-admin or recipient-memory credential.
# NARA_CONTENT_ADMIN_TOKEN=replace-with-at-least-24-random-characters
# NARA_CONTENT_AUTHOR_SUBJECT_ID=person:creator
# NARA_CONTENT_ALLOWED_VIEWER_IDS=person:partner
# NARA_CONTENT_DEFAULT_VIEWER_IDS=person:partner
# NARA_CONTENT_ALLOW_PUBLIC=false

# Optional GitHub Releases-backed OTA catalog.
# Stable is the default for every device. NARA_OTA_ADMIN_TOKEN enables the
# authenticated per-device stable/beta channel management endpoint.
# NARA_OTA_GITHUB_REPO=man612/nara-firmware
# NARA_OTA_GITHUB_TOKEN=
# NARA_OTA_CHANNELS_FILE=data/device-update-channels.json
# NARA_OTA_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Optional Spotify control/search. The compact media tool is not exposed to
# the voice model unless all three values are configured, keeping tool-schema
# prompt cost at zero when Spotify is unused.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=

# Optional dedicated web search. Configure the matching provider in
# providers.yaml. SearXNG JSON output must be enabled server-side.
# SEARXNG_BASE_URL=http://127.0.0.1:8080

# Optional Hermes Agent delegation. HERMES_BASE_URL is the server root;
# Nara appends /v1/runs itself. A managed SumoPod deployment can be supplied
# here without changing firmware or runtime code. The tool is exposed only
# when HERMES_API_KEY is non-empty.
HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_PROFILE=
# HERMES_MODEL=
# HERMES_PROVIDER=
# HERMES_INSTRUCTIONS=

# Optional deterministic weather/briefing source. Coordinates are deployment
# configuration, not committed personal data.
# NARA_WEATHER_LATITUDE=
# NARA_WEATHER_LONGITUDE=
# NARA_WEATHER_TIMEZONE=Asia/Jakarta
# NARA_DAILY_BRIEFING_TIME=07:00
# NARA_DAILY_BRIEFING_TIMEZONE=Asia/Jakarta
# NARA_DAILY_BRIEFING_SPEAK=false

# Provider-balance watcher. Direct provider status APIs are used; no LLM call
# is spent merely to check balance. Spoken warnings remain opt-in.
NARA_AI_BUDGET_LOW_USD=2
NARA_AI_BUDGET_CRITICAL_USD=0.5
NARA_AI_BUDGET_CHECK_MINUTES=30
NARA_AI_BUDGET_SPEAK_WARNINGS=false

# Optional local soft budget for provider-reported realtime voice tokens.
# This is deliberately a Nara-side guard, not a claim about an undisclosed
# provider account quota. Warnings are local device notifications and spend
# no extra model tokens.
# NARA_VOICE_DAILY_TOKEN_BUDGET=250000
# NARA_VOICE_TOKEN_BUDGET_LOW_FRACTION=0.80
# NARA_VOICE_TOKEN_BUDGET_CRITICAL_FRACTION=0.95
# NARA_VOICE_TOKEN_BUDGET_TIMEZONE=Asia/Jakarta

# Durable per-device remote inbox. Firmware polls this edge with its existing
# device credential while idle; no realtime AI session is kept open.
NARA_REMOTE_INBOX_FILE=data/remote-inbox.json
NARA_REMOTE_INBOX_TTL_MINUTES=15
NARA_REMOTE_INBOX_LEASE_SECONDS=45
NARA_REMOTE_INBOX_MAX_PER_DEVICE=16

# Optional allowlisted Telegram long-poll bridge. Numeric user IDs are safer
# than usernames because usernames can change. With NARA_COMPANION_DEVICE_ID,
# /ask, /say and /notify can queue while the target device is idle. /notify
# remains local/token-free; /ask and /say open realtime voice only when the
# firmware polls the queued wake. /agent delegates long work to Hermes.
# NARA_TELEGRAM_BOT_TOKEN=
# NARA_TELEGRAM_ALLOWED_USER_IDS=
# NARA_COMPANION_DEVICE_ID=

# Optional GPT-Live native full-duplex voice route. Keep the API key
# server-side; firmware never receives provider credentials.
# OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
# OPENAI_LIVE_VOICE=marin
# OPENAI_LIVE_SYSTEM_INSTRUCTION=Be concise and natural. Delegate tool or reasoning work instead of guessing.
# OPENAI_LIVE_BACKEND_INSTRUCTIONS=Use available Nara tools when they are necessary to answer accurately.

# Optional chained STT -> brain -> TTS voice route. The example provider file
# defaults these to local OpenAI-compatible speech endpoints. Set the URLs/models
# for the speech servers you actually deploy; no speech provider is mandatory.
# NARA_STT_BASE_URL=http://127.0.0.1:8001/v1
# NARA_STT_MODEL=whisper-1
# NARA_STT_LANGUAGE=id
# NARA_TTS_BASE_URL=http://127.0.0.1:8002/v1
# NARA_TTS_MODEL=tts-1
# NARA_TTS_VOICE=alloy
# NARA_CHAINED_SYSTEM_INSTRUCTION=Be concise and natural.

# Model names are config, not source-code dependencies.
GEMINI_LIVE_MODEL=gemini-3.8-live
DEEPSEEK_MODEL=deepseek-flash
OPENROUTER_MODEL=openrouter/auto

# Provider/API secrets stay server-side. Never put these in ESP32 firmware.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HERMES_API_KEY=
